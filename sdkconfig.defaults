# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/openindus/partitions.csv"
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
CONFIG_ARDUINO_SELECTIVE_EEPROM=n
CONFIG_ARDUINO_SELECTIVE_Preferences=n
CONFIG_ARDUINO_SELECTIVE_Ticker=n
CONFIG_ARDUINO_SELECTIVE_Update=n
CONFIG_ARDUINO_SELECTIVE_Zigbee=n
CONFIG_ARDUINO_SELECTIVE_PPP=n
CONFIG_ARDUINO_SELECTIVE_ArduinoOTA=n
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=n
CONFIG_ARDUINO_SELECTIVE_DNSServer=n
CONFIG_ARDUINO_SELECTIVE_ESPmDNS=n
CONFIG_ARDUINO_SELECTIVE_HTTPClient=n
CONFIG_ARDUINO_SELECTIVE_Matter=n
CONFIG_ARDUINO_SELECTIVE_NetBIOS=n
CONFIG_ARDUINO_SELECTIVE_WebServer=n
CONFIG_ARDUINO_SELECTIVE_NetworkClientSecure=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n
CONFIG_ARDUINO_SELECTIVE_RainMaker=n
CONFIG_ARDUINO_SELECTIVE_OpenThread=n
CONFIG_ARDUINO_SELECTIVE_Insights=n
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_PPP_SUPPORT=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y
# esp_diagnostics (pulled in transitively by arduino) wraps esp_log_write/writev
# via -Wl,--wrap. ESP-Insights is disabled, so the wrap is unused and its
# fragile link ordering leaves __wrap_esp_log_write undefined against esp_wifi.
# Disable the internal wrap; nothing external wraps logging here.
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=y

# Without auto-suspend, every flash write (i.e. every esp_ota_write) turns the flash
# cache off and parks the other core, and any application interrupt that is not
# IRAM-safe and fires on the flashing core during the handshake that gets there
# deadlocks the operation -- reported as "Interrupt wdt timeout". That makes OTA
# dependent on what the application does, which it must not be. With auto-suspend the
# flash controller suspends the erase/program whenever the cache needs the bus, so no
# cache is disabled, no core is parked and no interrupt is masked.
# The trade is some latency jitter (tSUS, see CONFIG_SPI_FLASH_SUSPEND_TSUS_VAL_US) and
# slower erase/write throughput. Requires a flash part whose suspend support has been
# qualified -- check the part against `Optional Features for Flash` > `Auto Suspend &
# Resume` in the ESP-IDF Programming Guide, and tSUS against its datasheet.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y